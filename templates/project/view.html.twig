{% extends 'base.html.twig' %}

{% block title %} = {{title}}{% endblock %}

{% block body %}
    <h1>{{title}}</h1>
    <a href="{{ path(routecancel) }}" class="btn btn-secondary mb-3">Liste des Projets</a>

    <div class="card mb-3">
        <div class="card-header">
            <a href="{{ path(routesubmit,{idProject: project.project.id}) }}" class="btn btn-success">Ajouter</a>
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered table-hover mb-0" style="width:100%">
                <thead>
                <tr>
                    <th width="70px" class="no-sort">Action</th>
                    <th>Titre</th>
                    <th width="150px">Min</th>
                    <th width="150px">-</th>
                    <th width="150px">Max</th>
                </tr>
                </thead>

                {% set totalOptimistic = 0 %}
                {% set totalLikely = 0 %}
                {% set totalPessimistic = 0 %}
                {% set catOptimistic = 0 %}
                {% set catLikely = 0 %}
                {% set catPessimistic = 0 %}
                {% set currentCategory = null %}
                {% set currentCategoryLabel = null %}

                {% for task in project.guesstimate.tasks|sort((a, b) => a.category <=> b.category) %}
                    {% if currentCategory != task.category %}
                        {% if currentCategory is not null %}
                            </tbody>
                            <tbody>
                            <tr class="table-secondary fw-bold">
                                <td colspan="2" class="text-end">Total {{ currentCategoryLabel }}</td>
                                <td>{{ catOptimistic }}</td>
                                <td>{{ catLikely }}</td>
                                <td>{{ catPessimistic }}</td>
                            </tr>
                            </tbody>
                        {% endif %}
                        <tbody>
                        <tr class="table-primary fw-bold">
                            <td colspan="5">{{ task.categoryLabel }}</td>
                        </tr>
                        </tbody>
                        <tbody class="sortable-tasks" data-category="{{ task.category }}">
                        {% set currentCategory = task.category %}
                        {% set currentCategoryLabel = task.categoryLabel %}
                        {% set catOptimistic = 0 %}
                        {% set catLikely = 0 %}
                        {% set catPessimistic = 0 %}
                    {% endif %}

                    {% set catOptimistic = catOptimistic + task.estimations.optimistic %}
                    {% set catLikely = catLikely + task.estimations.likely %}
                    {% set catPessimistic = catPessimistic + task.estimations.pessimistic %}
                    {% set totalOptimistic = totalOptimistic + task.estimations.optimistic %}
                    {% set totalLikely = totalLikely + task.estimations.likely %}
                    {% set totalPessimistic = totalPessimistic + task.estimations.pessimistic %}

                    <tr data-id="{{ task.id }}" style="cursor: move;">
                        <td class="text-center">
                            <a href="{{ path(routeupdate,{idProject:project.project.id,id:task.id}) }}"><i class="fas fa-file fa-2x"></i></a>
                        </td>
                        <td>{{task.label}}</td>
                        <td>{{task.estimations.optimistic}}</td>
                        <td>{{task.estimations.likely}}</td>
                        <td>{{task.estimations.pessimistic}}</td>
                    </tr>
                {% endfor %}

                {% if currentCategory is not null %}
                    </tbody>
                    <tbody>
                    <tr class="table-secondary fw-bold">
                        <td colspan="2" class="text-end">Total {{ currentCategoryLabel }}</td>
                        <td>{{ catOptimistic }}</td>
                        <td>{{ catLikely }}</td>
                        <td>{{ catPessimistic }}</td>
                    </tr>
                    </tbody>
                {% endif %}

                <tbody>
                <tr class="table-dark fw-bold">
                    <td colspan="2" class="text-end">Total Général</td>
                    <td>{{ totalOptimistic }}</td>
                    <td>{{ totalLikely }}</td>
                    <td>{{ totalPessimistic }}</td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Financier
                </div>
                <div class="card-body">
                    <table class="table table-striped table-bordered table-hover mb-0" style="width:100%">
                        <thead>
                            <tr>
                                <td colspan=2>Min</td>
                                <td colspan=2>Max</td>
                            </tr>
                            <tr>
                                <td>Qte</td>
                                <td>{{project.guesstimate.costs.currency}}</td>
                                <td>Qte</td>
                                <td>{{project.guesstimate.costs.currency}}</td>
                            </tr>
                        <thead>
                        <tbody>
                            <tr>
                                <td>{{project.guesstimate.costs.min.time}}</td>
                                <td>{{project.guesstimate.costs.min.cost|number_format(2, ',', ' ')}}</td>
                                <td>{{project.guesstimate.costs.max.time}}</td>
                                <td>{{project.guesstimate.costs.max.cost|number_format(2, ',', ' ')}}</td>
                            </tr>
                        <tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Confiances
                </div>
                <div class="card-body">
                    <table class="table table-striped table-bordered table-hover mb-0" style="width:100%">
                        <thead>
                            <tr>
                                <td>Confiance</td>
                                <td>Min</td>
                                <td>Max</td>
                            </tr>
                        <thead>
                        <tbody>
                            <tr>
                                <td>Confiance à {{project.guesstimate.statistics.confidence68.level}}</td>
                                <td>{{project.guesstimate.statistics.confidence68.min}}</td>
                                <td>{{project.guesstimate.statistics.confidence68.max}}</td>
                            </tr>

                            <tr>
                                <td>Confiance à {{project.guesstimate.statistics.confidence90.level}}</td>
                                <td>{{project.guesstimate.statistics.confidence90.min}}</td>
                                <td>{{project.guesstimate.statistics.confidence90.max}}</td>
                            </tr>

                            <tr>
                                <td>Confiance à {{project.guesstimate.statistics.confidence997.level}}</td>
                                <td>{{project.guesstimate.statistics.confidence997.min}}</td>
                                <td>{{project.guesstimate.statistics.confidence997.max}}</td>
                            </tr>                            
                        <tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Catégories
                </div>
                <div class="card-body">
                    <table class="table table-striped table-bordered table-hover mb-0" style="width:100%">
                        <thead>
                            <tr>
                                <td>Catégories</td>
                                <td>Qte</td>
                                <td>%</td>
                            </tr>
                        <thead>
                        <tbody>
                            {% for category in project.guesstimate.categoryDistribution %}
                                <tr>
                                    <td>{{category.categoryLabel}}</td>
                                    <td>{{category.time}}</td>
                                    <td>{{category.percentage|number_format(2, ',', ' ')}}</td>
                                </tr>
                            {% endfor %}
                        <tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>    
{% endblock %}

{% block localscript %}
    <script>
        $(document).ready(function() {
            $(".sortable-tasks").sortable({
                helper: function(e, tr) {
                    var $originals = tr.children();
                    var $helper = tr.clone();
                    $helper.children().each(function(index) {
                        $(this).width($originals.eq(index).width());
                    });
                    return $helper;
                },
                stop: function(event, ui) {
                    var taskIds = [];
                    $('.sortable-tasks tr[data-id]').each(function() {
                        taskIds.push($(this).data('id'));
                    });

                    console.log(taskIds);

                    $.ajax({
                        url: "{{ path('app_task_reorder', {idProject: project.project.id}) }}",
                        method: "POST",
                        data: {
                            taskIds: taskIds
                        },
                        success: function(response) {
                            // Optionnel : Afficher une notification de succès
                            console.log("Ordre mis à jour");
                        },
                        error: function(xhr) {
                            // Gérer l'erreur (ex: afficher le toast d'erreur existant)
                            $('#ajaxErrorMessage').text("Erreur lors du déplacement de la tâche");
                            var toast = new bootstrap.Toast(document.getElementById('ajaxErrorToast'));
                            toast.show();
                            // Annuler le déplacement visuel si nécessaire
                            $(this).sortable('cancel');
                        }
                    });
                }
            }).disableSelection();
        });
    </script>
{% endblock %}
